{
  "permissions": {
    "allow": [
      "Bash(sed -i.bak*)",
      "mcp__ide__getDiagnostics",
      "Bash(npx next build:*)",
      "mcp__ide__executeCode",
      "Bash(git add -A && git diff --cached --quiet || git commit -m 'auto-checkpoint:*)",
      "Bash(git status)",
      "Bash(git diff)",
      "Bash(git log)",
      "Bash(git commit)",
      "Bash(git add)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "git add -A && git diff --cached --quiet || git commit -m 'auto-checkpoint: ${CLAUDE_TOOL_INPUT}'"
          }
        ]
      }
    ]
  }
}
